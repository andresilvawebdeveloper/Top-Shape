{
  "expo": {
    "name": "top-shape",
    "slug": "top-shape",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.oseunome.top-shape",
      "infoPlist": {
        "NSCameraUsageDescription": "O Top Shape precisa de aceder à câmara para contar as suas repetições de forma automática."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.oseunome.top-shape",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "O Top Shape precisa de aceder à câmara para detetar os seus movimentos."
        }
      ],
      "expo-asset"
    ]
  }
}
